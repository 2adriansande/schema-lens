# ══════════════════════════════════════════════════════════
# SchemaLens — Environment Configuration Template
# ══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════

# ── Flask Secret Key ───────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-secret-key

# ── Gemini API Key (Server-Side Only) ─────────────────────
# Obtain from: https://aistudio.google.com/app/apikey
# This key is NEVER sent to the browser or exposed in any API response.
# It is loaded exclusively in the Python backend at startup.
GEMINI_API_KEY=your-gemini-api-key-here

# ── Ollama (Optional Local LLM) ───────────────────────────
# If running Ollama locally, set the base URL here.
# Leave as default if not using Ollama.
OLLAMA_BASE_URL=http://localhost:11434

# ── Database (Optional Override) ──────────────────────────
# By default, SchemaLens uses SQLite at ./schemalens.db
# Uncomment to override with a different SQLite path or PostgreSQL URI.
# SQLALCHEMY_DATABASE_URI=sqlite:///schemalens.db
