# ── Environment / Secrets ──────────────────────────────────
# Never commit files that may contain the GEMINI_API_KEY or other secrets.
.env
.env.local
.env.*
!.env.example

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ── Database ────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Uploads (user-generated content) ───────────────────────
static/uploads/*
!static/uploads/.gitkeep

# ── Editor / OS ─────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
*.log
